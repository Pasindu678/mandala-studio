# ========================================================
# Mandala Studio Environment Configuration Template
# ========================================================

# Database Connection
# SQLite (Local Development):
DATABASE_URL="file:./dev.db"

# PostgreSQL (Production / Supabase / Neon / Render / Local PG):
# DATABASE_URL="postgresql://username:password@localhost:5432/mandala_studio?schema=public"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication & JWT Secrets
JWT_SECRET="generate_a_random_32_character_secret_string"
NEXTAUTH_SECRET="generate_another_random_secret_string"

# Stripe Payment Gateway
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Payment Mode: 'mock' for sandbox/testing without keys, 'stripe' for live/test Stripe
NEXT_PUBLIC_PAYMENT_MODE="mock"
